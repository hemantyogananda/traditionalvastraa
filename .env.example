# Supabase (Project Settings > API in your Supabase dashboard)
# After setting these, run supabase/schema.sql once in the Supabase SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay (use TEST mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP settings used to send order emails (e.g. Gmail, Brevo, Mailtrap, SES SMTP, etc.)
# For Gmail: host=smtp.gmail.com, port=587, user=orders@traditionalvastraa.com,
# password = a 16-character Gmail "App Password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@traditionalvastraa.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: overrides the "From" header on outgoing order emails.
EMAIL_FROM="Traditional Vastraa <orders@traditionalvastraa.com>"
